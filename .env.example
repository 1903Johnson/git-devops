# Copy to .env and adjust as needed. Every value here is a safe local default — real
# secrets never live in this file, and .env itself is gitignored and rejected by the
# hygiene CI job if it is ever committed.

# --- Ports -------------------------------------------------------------------
# Override any of these if something else on your machine already holds the port.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=church_dev

# Application connection string. Matches the variable name the CI integration job sets,
# so the same commands work locally and in the pipeline.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/church_dev

# The integration and isolation suites run against this database, created on first start
# by infra/local/init-databases.sh.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/church_test

# Unprivileged role the migrations grant to. Production sets its own; leaving this as the
# test role keeps `pnpm -r run migrate:test` working locally with no extra setup.
APP_DB_ROLE=app_test

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO) --------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=church-local
S3_REGION=us-east-1

# --- Email (Mailpit) ---------------------------------------------------------
# Mailpit swallows everything it receives; nothing sent locally can reach a real
# congregation. Inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_FROM=no-reply@church.local
