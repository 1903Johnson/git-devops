{
  "name": "church-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant church management platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:unit": "pnpm -r --if-present run test:unit",
    "verify": "pnpm run check:boundaries && pnpm run check:docs && pnpm run contracts:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "contracts:generate": "pnpm --filter @church/contracts run generate",
    "contracts:check": "node scripts/check-contracts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/react-vite": "^10.5.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.15.0",
    "jsdom": "^30.0.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.0",
    "prettier": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.9",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
