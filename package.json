{
  "name": "church-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant church management platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:unit": "pnpm -r --if-present run test:unit",
    "verify": "pnpm run check:boundaries && pnpm run check:docs && pnpm run lint && pnpm run typecheck && pnpm run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
